# Server
NODE_ENV=development
PORT=3000

# Database (SQLite file path — swap to PostgreSQL later by changing provider + URL)
DATABASE_URL="file:./dev.db"

# Auth
JWT_SECRET=change-me-to-a-long-random-secret-in-real-use
JWT_EXPIRES_IN=2h
BCRYPT_COST=10

# CORS — comma-separated origins; use * for public-open demo
CORS_ORIGINS=*

# Order payment window (minutes)
ORDER_EXPIRY_MINUTES=60

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_ORDERS_MAX=30

# Logging
LOG_LEVEL=info
WEBHOOK_TIMEOUT_MS=5000
WEBHOOK_MAX_ATTEMPTS=3
